{
  "name": "@vape/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude test/integration/**",
    "test:unit": "vitest run src",
    "test:integration": "node test/integration/run-integration.mjs",
    "test:security": "vitest run test/security --passWithNoTests",
    "test:e2e:fixture": "node test/e2e/seed-operational-fixture.mjs",
    "test:e2e:operational": "node test/e2e/run-operational-e2e.mjs",
    "admin:create": "tsx src/cli/admin-create.ts",
    "catalog:import:wotofo": "tsx src/cli/catalog-import-wotofo.ts",
    "catalog:media:wotofo": "tsx src/cli/catalog-media-wotofo.ts",
    "catalog:verify:wotofo": "tsx src/cli/catalog-verify-wotofo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1090.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@prisma/client": "6.19.3",
    "@vape/shared-types": "workspace:*",
    "@vape/validation": "workspace:*",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "google-auth-library": "10.9.1",
    "helmet": "8.2.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "otplib": "13.4.1",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.3",
    "undici": "7.29.0",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.10",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
