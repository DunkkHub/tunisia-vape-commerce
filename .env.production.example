# Production host-separated baseline template. Copy to a secret-managed deployment environment;
# never commit the populated copy. Every REPLACE_* value is intentionally invalid until replaced.
NODE_ENV=production
WEB_URL=https://store.example.tn
ADMIN_WEB_URL=https://admin.example.tn
COMPOSE_WEB_URL=https://store.example.tn
PUBLIC_API_URL=https://store.example.tn/api/v1
STOREFRONT_HOST=store.example.tn
ADMIN_HOST=admin.example.tn
# Disabled unless an operator deliberately enables access on the private admin host.
OPENAPI_ENABLED=false

# Least-privilege application and migration identities. URL-encode passwords.
DATABASE_URL=mysql://app_user:REPLACE_WITH_URL_ENCODED_APP_PASSWORD@mysql:3306/vape_store
DATABASE_MIGRATION_URL=mysql://migration_user:REPLACE_WITH_URL_ENCODED_MIGRATION_PASSWORD@mysql:3306/vape_store
REDIS_URL=redis://:REPLACE_WITH_URL_ENCODED_REDIS_PASSWORD@redis:6379/0

# Docker secret files; create them outside the repository with mode 0600.
MYSQL_ROOT_PASSWORD_FILE=./secrets/mysql_root_password
MYSQL_APP_PASSWORD_FILE=./secrets/mysql_app_password
MYSQL_MIGRATION_PASSWORD_FILE=./secrets/mysql_migration_password
REDIS_PASSWORD_FILE=./secrets/redis_password

# Independent high-entropy values (32+ characters); inject from a secret manager.
COOKIE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
FIELD_ENCRYPTION_KEY=REPLACE_WITH_AN_INDEPENDENT_32_CHAR_KEY

# Launch controls. Checkout still requires real store identity and a usable delivery method.
CHECKOUT_ENABLED=true
MAINTENANCE_MODE=false
PRELAUNCH_MODE=false
MINIMUM_PURCHASE_AGE=18
EXPECTED_MIGRATION_NAME=20260721023000_unverified_operator_source_urls
HEALTHCHECK_TIMEOUT_MS=2000
WORKER_HEARTBEAT_MAX_AGE_SECONDS=60
WORKER_HEALTHCHECK_MAX_AGE_SECONDS=60

# S3-compatible object storage. Prefer private endpoints and scoped credentials.
S3_ENDPOINT=https://objects.example.tn
S3_REGION=tn-1
S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET_NAME
S3_ACCESS_KEY=REPLACE_WITH_SCOPED_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_SCOPED_SECRET_KEY
S3_FORCE_PATH_STYLE=false
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PIXELS=40000000
# Comma-separated exact HTTPS hostnames controlled by the operator; empty disables generic URL imports.
CATALOG_IMPORT_MEDIA_HOSTS=

# SMTP is required for the production worker. SMS remains optional and disabled by default.
NOTIFICATION_BRIDGE_ENABLED=true
SMTP_HOST=smtp.example.tn
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_AT_LEAST_16_RANDOM_CHARACTERS
EMAIL_FROM=orders@example.tn
EMAIL_FROM_NAME=Tunisia Vape Commerce
SMS_ENABLED=false
SMS_WEBHOOK_URL=
SMS_WEBHOOK_AUTH_TOKEN=
SMS_SENDER=TunisiaVape

LOG_LEVEL=info
