  HANDED_TO_COURIER
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERY_ATTEMPTED
  RESCHEDULED
  DELIVERED
  REFUSED
  FAILED
  RETURN_TO_SENDER
  RETURNED
  CANCELLED
}

enum PaymentStatus {
