  discountTotalMillimes             Int                    @default(0)
  deliveryTotalMillimes             Int                    @default(0)
  taxTotalMillimes                  Int                    @default(0)
  grandTotalMillimes                Int
  expectedCodMillimes               Int
  deliveryMethodType                DeliveryMethodType
  deliveryMethodSnapshot            String                 @db.VarChar(200)
  deliveryZoneId                    String?                @db.VarChar(30)
  deliveryRateId                    String?                @db.VarChar(30)
  pickupLocationId                  String?                @db.VarChar(30)
  deliveryTimeWindowId              String?                @db.VarChar(30)
