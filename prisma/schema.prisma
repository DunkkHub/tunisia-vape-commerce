generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Authentication and RBAC

enum AuthAudience {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
  ANONYMIZED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum VerificationChannel {
  EMAIL
  SMS
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  ADMIN_INVITATION
  TWO_FACTOR_ENROLLMENT
}

model User {
  id                  String                @id @default(cuid()) @db.VarChar(30)
  audience            AuthAudience
  email               String?               @db.VarChar(320)
  emailNormalized     String?               @unique @db.VarChar(320)
  passwordHash        String                @db.VarChar(255)
  status              UserStatus            @default(PENDING_VERIFICATION)
  emailVerifiedAt     DateTime?             @db.DateTime(3)
  phoneVerifiedAt     DateTime?             @db.DateTime(3)
  passwordChangedAt   DateTime?             @db.DateTime(3)
  failedLoginCount    Int                   @default(0)
  lockedUntil         DateTime?             @db.DateTime(3)
  lastLoginAt         DateTime?             @db.DateTime(3)
  version             Int                   @default(1)
  createdAt           DateTime              @default(now()) @db.DateTime(3)
  updatedAt           DateTime              @updatedAt @db.DateTime(3)
  deletedAt           DateTime?             @db.DateTime(3)
  customerProfile     CustomerProfile?
  adminProfile        AdminProfile?
  sessions            Session[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  twoFactorSecret     TwoFactorSecret?
  recoveryCodes       RecoveryCode[]
  roles               UserRole[]
  courierMemberships  CourierUser[]
  loginAttempts       LoginAttempt[]
  securityEvents      SecurityEvent[]
  auditLogs           AuditLog[]            @relation("AuditActor")
  approvalsRequested  AdminActionApproval[] @relation("ApprovalRequester")
  approvalsDecided    AdminActionApproval[] @relation("ApprovalDecider")

  @@index([audience, status])
  @@index([emailNormalized, audience])
  @@index([deletedAt])
}

model CustomerProfile {
  id                    String                      @id @default(cuid()) @db.VarChar(30)
  userId                String                      @unique @db.VarChar(30)
  firstName             String                      @db.VarChar(100)
  lastName              String                      @db.VarChar(100)
  phoneE164             String                      @unique @db.VarChar(16)
  phoneSearch           String                      @db.VarChar(16)
  locale                String                      @default("fr") @db.VarChar(10)
  dateOfBirth           DateTime?                   @db.Date
  marketingConsent      Boolean                     @default(false)
  suspendedAt           DateTime?                   @db.DateTime(3)
  suspensionReason      String?                     @db.VarChar(500)
  anonymizedAt          DateTime?                   @db.DateTime(3)
  version               Int                         @default(1)
  createdAt             DateTime                    @default(now()) @db.DateTime(3)
  updatedAt             DateTime                    @updatedAt @db.DateTime(3)
  user                  User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  addresses             Address[]
  tagAssignments        CustomerTagAssignment[]
  notes                 CustomerNote[]
  riskEvents            CustomerRiskEvent[]
  blocklistEntries      CustomerBlocklistEntry[]
  dataExportRequests    CustomerDataExportRequest[]
  deletionRequests      CustomerDeletionRequest[]
  carts                 Cart[]
  wishlists             Wishlist[]
  orders                Order[]
  promotionRedemptions  PromotionRedemption[]
  consentRecords        ConsentRecord[]
  ageVerificationEvents AgeVerificationEvent[]
  returnRequests        ReturnRequest[]

  @@index([phoneSearch])
  @@index([lastName, firstName])
  @@index([suspendedAt])
}

model AdminProfile {
  id                   String    @id @default(cuid()) @db.VarChar(30)
  userId               String    @unique @db.VarChar(30)
  displayName          String    @db.VarChar(200)
  employeeCode         String?   @unique @db.VarChar(50)
  jobTitle             String?   @db.VarChar(120)
  mustEnrollTwoFactor  Boolean   @default(true)
  twoFactorEnforcedAt  DateTime? @db.DateTime(3)
  lastStepUpAt         DateTime? @db.DateTime(3)
  allowedIpCidrs       Json?
  suspendedAt          DateTime? @db.DateTime(3)
  suspensionReason     String?   @db.VarChar(500)
  invitationAcceptedAt DateTime? @db.DateTime(3)
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @db.DateTime(3)
  updatedAt            DateTime  @updatedAt @db.DateTime(3)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([suspendedAt])
}

model Session {
  id                String          @id @default(cuid()) @db.VarChar(30)
  userId            String          @db.VarChar(30)
  audience          AuthAudience
  tokenHash         String          @unique @db.Char(64)
  csrfTokenHash     String?         @db.Char(64)
  status            SessionStatus   @default(ACTIVE)
  ipAddress         String?         @db.VarChar(45)
  userAgent         String?         @db.VarChar(512)
  authenticatedAt   DateTime        @default(now()) @db.DateTime(3)
  twoFactorVerified Boolean         @default(false)
  createdAt         DateTime        @default(now()) @db.DateTime(3)
  lastSeenAt        DateTime        @default(now()) @db.DateTime(3)
  idleExpiresAt     DateTime        @db.DateTime(3)
  absoluteExpiresAt DateTime        @db.DateTime(3)
  revokedAt         DateTime?       @db.DateTime(3)
  revokedReason     String?         @db.VarChar(255)
  rotatedFromId     String?         @unique @db.VarChar(30)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rotatedFrom       Session?        @relation("SessionRotation", fields: [rotatedFromId], references: [id], onDelete: SetNull)
  rotatedTo         Session?        @relation("SessionRotation")
  securityEvents    SecurityEvent[]

  @@index([userId, audience, status])
  @@index([status, idleExpiresAt])
  @@index([status, absoluteExpiresAt])
}

model VerificationToken {
  id              String              @id @default(cuid()) @db.VarChar(30)
  userId          String              @db.VarChar(30)
  audience        AuthAudience
  channel         VerificationChannel
  purpose         VerificationPurpose
  destinationHash String              @db.Char(64)
  tokenHash       String              @unique @db.Char(64)
  expiresAt       DateTime            @db.DateTime(3)
  consumedAt      DateTime?           @db.DateTime(3)
  attemptCount    Int                 @default(0)
  createdAt       DateTime            @default(now()) @db.DateTime(3)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt, consumedAt])
}

model PasswordResetToken {
  id          String       @id @default(cuid()) @db.VarChar(30)
  userId      String       @db.VarChar(30)
  audience    AuthAudience
  tokenHash   String       @unique @db.Char(64)
  requestedIp String?      @db.VarChar(45)
  expiresAt   DateTime     @db.DateTime(3)
  consumedAt  DateTime?    @db.DateTime(3)
  createdAt   DateTime     @default(now()) @db.DateTime(3)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt, consumedAt])
}

model TwoFactorSecret {
  id              String    @id @default(cuid()) @db.VarChar(30)
  userId          String    @unique @db.VarChar(30)
  encryptedSecret String    @db.Text
  encryptionKeyId String    @db.VarChar(100)
  verifiedAt      DateTime? @db.DateTime(3)
  lastUsedStep    BigInt?
  createdAt       DateTime  @default(now()) @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @db.DateTime(3)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecoveryCode {
  id        String    @id @default(cuid()) @db.VarChar(30)
  userId    String    @db.VarChar(30)
  codeHash  String    @unique @db.Char(64)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  usedAt    DateTime? @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model Role {
  id          String           @id @default(cuid()) @db.VarChar(30)
  key         String           @unique @db.VarChar(80)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.DateTime(3)
  updatedAt   DateTime         @updatedAt @db.DateTime(3)
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid()) @db.VarChar(30)
  key         String           @unique @db.VarChar(120)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @db.DateTime(3)
  roles       RolePermission[]
}

model UserRole {
  userId     String   @db.VarChar(30)
  roleId     String   @db.VarChar(30)
  assignedAt DateTime @default(now()) @db.DateTime(3)
  assignedBy String?  @db.VarChar(30)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.VarChar(30)
  permissionId String     @db.VarChar(30)
  grantedAt    DateTime   @default(now()) @db.DateTime(3)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// Customer Management

enum AddressType {
  HOME
  WORK
  OTHER
}

enum CustomerRequestStatus {
  REQUESTED
  IDENTITY_VERIFICATION
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum CustomerRiskType {
  COD_REFUSAL
  FAILED_DELIVERY
  DUPLICATE_ACCOUNT
  FRAUD_INDICATOR
  CHARGEBACK_OR_REFUND_ABUSE
  MANUAL_REVIEW
}

enum BlocklistStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model Address {
  id                   String          @id @default(cuid()) @db.VarChar(30)
  customerId           String          @db.VarChar(30)
  type                 AddressType     @default(HOME)
  label                String?         @db.VarChar(100)
  fullName             String          @db.VarChar(200)
  phoneE164            String          @db.VarChar(16)
  governorateId        String          @db.VarChar(30)
  delegationId         String          @db.VarChar(30)
  localityId           String?         @db.VarChar(30)
  postalCode           String?         @db.VarChar(10)
  street               String          @db.VarChar(255)
  building             String?         @db.VarChar(100)
  floor                String?         @db.VarChar(30)
  apartment            String?         @db.VarChar(30)
  landmark             String?         @db.VarChar(255)
  deliveryInstructions String?         @db.VarChar(1000)
  isDefault            Boolean         @default(false)
  version              Int             @default(1)
  createdAt            DateTime        @default(now()) @db.DateTime(3)
  updatedAt            DateTime        @updatedAt @db.DateTime(3)
  deletedAt            DateTime?       @db.DateTime(3)
  customer             CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  governorate          Governorate     @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  delegation           Delegation      @relation(fields: [delegationId], references: [id], onDelete: Restrict)
  locality             Locality?       @relation(fields: [localityId], references: [id], onDelete: Restrict)

  @@index([customerId, deletedAt])
  @@index([phoneE164])
  @@index([governorateId, delegationId, localityId])
}

model CustomerTag {
  id          String                  @id @default(cuid()) @db.VarChar(30)
  key         String                  @unique @db.VarChar(80)
  label       String                  @db.VarChar(120)
  color       String?                 @db.VarChar(20)
  createdAt   DateTime                @default(now()) @db.DateTime(3)
  assignments CustomerTagAssignment[]
}

model CustomerTagAssignment {
  customerId String          @db.VarChar(30)
  tagId      String          @db.VarChar(30)
  assignedAt DateTime        @default(now()) @db.DateTime(3)
  assignedBy String?         @db.VarChar(30)
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        CustomerTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@index([tagId])
}

model CustomerNote {
  id         String          @id @default(cuid()) @db.VarChar(30)
  customerId String          @db.VarChar(30)
  authorId   String          @db.VarChar(30)
  body       String          @db.Text
  createdAt  DateTime        @default(now()) @db.DateTime(3)
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([authorId, createdAt])
}

model CustomerRiskEvent {
  id         String           @id @default(cuid()) @db.VarChar(30)
  customerId String           @db.VarChar(30)
  type       CustomerRiskType
  scoreDelta Int              @default(0)
  sourceType String           @db.VarChar(80)
  sourceId   String?          @db.VarChar(30)
  summary    String           @db.VarChar(500)
  metadata   Json?
  reviewedAt DateTime?        @db.DateTime(3)
  reviewedBy String?          @db.VarChar(30)
  createdAt  DateTime         @default(now()) @db.DateTime(3)
  customer   CustomerProfile  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([type, createdAt])
}

model CustomerBlocklistEntry {
  id           String           @id @default(cuid()) @db.VarChar(30)
  customerId   String?          @db.VarChar(30)
  phoneHash    String?          @db.Char(64)
  emailHash    String?          @db.Char(64)
  status       BlocklistStatus  @default(ACTIVE)
  permanent    Boolean          @default(false)
  reasonCode   String           @db.VarChar(80)
  reasonDetail String?          @db.VarChar(500)
  startsAt     DateTime         @default(now()) @db.DateTime(3)
  expiresAt    DateTime?        @db.DateTime(3)
  createdBy    String           @db.VarChar(30)
  revokedAt    DateTime?        @db.DateTime(3)
  revokedBy    String?          @db.VarChar(30)
  customer     CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId, status])
  @@index([phoneHash, status])
  @@index([emailHash, status])
  @@index([status, expiresAt])
}

model CustomerDataExportRequest {
  id              String                @id @default(cuid()) @db.VarChar(30)
  customerId      String                @db.VarChar(30)
  status          CustomerRequestStatus @default(REQUESTED)
  requestedAt     DateTime              @default(now()) @db.DateTime(3)
  dueAt           DateTime?             @db.DateTime(3)
  completedAt     DateTime?             @db.DateTime(3)
  processedBy     String?               @db.VarChar(30)
  objectKey       String?               @db.VarChar(1024)
  expiresAt       DateTime?             @db.DateTime(3)
  rejectionReason String?               @db.VarChar(500)
  customer        CustomerProfile       @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, requestedAt])
  @@index([status, dueAt])
}

model CustomerDeletionRequest {
  id              String                @id @default(cuid()) @db.VarChar(30)
  customerId      String                @db.VarChar(30)
  status          CustomerRequestStatus @default(REQUESTED)
  requestedAt     DateTime              @default(now()) @db.DateTime(3)
  dueAt           DateTime?             @db.DateTime(3)
  completedAt     DateTime?             @db.DateTime(3)
  processedBy     String?               @db.VarChar(30)
  retainedFields  Json?
  rejectionReason String?               @db.VarChar(500)
  customer        CustomerProfile       @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, requestedAt])
  @@index([status, dueAt])
}

// Catalog

enum PublicationStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  ARCHIVED
}

enum ProductType {
  DEVICE
  E_LIQUID
  POD
  PREFILLED_POD_KIT
  PREFILLED_REPLACEMENT_POD
  COIL
  DISPOSABLE
  ACCESSORY
  OTHER
}

enum FlavorCategory {
  FRUIT
  MIXED_FRUIT
  MINT
  ICE
  DRINK
  TOBACCO
  DESSERT
  CANDY
  CLEAR
  OTHER
}

enum CatalogImportFormat {
  CSV
  JSON
  WOTOFO
}

enum CatalogImportSource {
  ADMIN_UPLOAD
  WOTOFO_OFFICIAL
}

enum CatalogImportStatus {
  PREVIEW_VALID
  PREVIEW_INVALID
  APPLYING
  APPLIED
  APPLIED_WITH_WARNINGS
  FAILED
  ROLLED_BACK
}

enum CatalogImportRowStatus {
  VALID
  INVALID
  CREATED
  UPDATED
  SKIPPED
  FAILED
  ROLLED_BACK
}

enum CatalogSourceEntityType {
  PRODUCT
  VARIANT
  IMAGE
}

enum ImageModerationStatus {
  PENDING
  APPROVED
  REJECTED
  QUARANTINED
}

enum SupplierStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Brand {
  id                String               @id @default(cuid()) @db.VarChar(30)
  name              String               @db.VarChar(160)
  slug              String               @unique @db.VarChar(180)
  descriptionFr     String?              @db.Text
  descriptionAr     String?              @db.Text
  publicationStatus PublicationStatus    @default(DRAFT)
  suspendedAt       DateTime?            @db.DateTime(3)
  archivedAt        DateTime?            @db.DateTime(3)
  deletedAt         DateTime?            @db.DateTime(3)
  createdAt         DateTime             @default(now()) @db.DateTime(3)
  updatedAt         DateTime             @updatedAt @db.DateTime(3)
  products          Product[]
  promotionLinks    PromotionBrand[]
  restrictions      ProductRestriction[]

  @@index([publicationStatus, deletedAt])
}

model Category {
  id                String               @id @default(cuid()) @db.VarChar(30)
  parentId          String?              @db.VarChar(30)
  nameFr            String               @db.VarChar(160)
  nameAr            String               @db.VarChar(160)
  slug              String               @unique @db.VarChar(180)
  descriptionFr     String?              @db.Text
  descriptionAr     String?              @db.Text
  sortOrder         Int                  @default(0)
  publicationStatus PublicationStatus    @default(DRAFT)
  suspendedAt       DateTime?            @db.DateTime(3)
  archivedAt        DateTime?            @db.DateTime(3)
  deletedAt         DateTime?            @db.DateTime(3)
  createdAt         DateTime             @default(now()) @db.DateTime(3)
  updatedAt         DateTime             @updatedAt @db.DateTime(3)
  parent            Category?            @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children          Category[]           @relation("CategoryTree")
  products          Product[]
  promotionLinks    PromotionCategory[]
  restrictions      ProductRestriction[]

  @@index([parentId, sortOrder])
  @@index([publicationStatus, deletedAt])
}

model Product {
  id                       String                @id @default(cuid()) @db.VarChar(30)
  brandId                  String?               @db.VarChar(30)
  categoryId               String                @db.VarChar(30)
  nameFr                   String                @db.VarChar(240)
  nameAr                   String                @db.VarChar(240)
  slug                     String                @unique @db.VarChar(260)
  sku                      String?               @unique @db.VarChar(100)
  barcode                  String?               @unique @db.VarChar(100)
  productType              ProductType
  family                   String?               @db.VarChar(120)
  model                    String?               @db.VarChar(160)
  shortDescriptionFr       String?               @db.VarChar(1000)
  shortDescriptionAr       String?               @db.VarChar(1000)
  descriptionFr            String?               @db.LongText
  descriptionAr            String?               @db.LongText
  containsNicotine         Boolean               @default(false)
  nicotineStrengthMg       Decimal?              @db.Decimal(8, 3)
  flavor                   String?               @db.VarChar(160)
  deviceType               String?               @db.VarChar(160)
  puffCount                Int?
  coilResistanceOhm        Decimal?              @db.Decimal(8, 3)
  liquidCapacityMl         Decimal?              @db.Decimal(8, 3)
  deviceCompatibility      String?               @db.VarChar(500)
  baseCostMillimes         Int?
  basePriceMillimes        Int?
  promotionalPriceMillimes Int?
  taxCategory              String?               @db.VarChar(80)
  taxRateBps               Int                   @default(0)
  warningFr                String?               @db.Text
  warningAr                String?               @db.Text
  minimumAge               Int?
  publicationStatus        PublicationStatus     @default(DRAFT)
  featured                 Boolean               @default(false)
  requiresPricing          Boolean               @default(false)
  requiresStock            Boolean               @default(false)
  needsMediaReview         Boolean               @default(false)
  seoTitleFr               String?               @db.VarChar(255)
  seoTitleAr               String?               @db.VarChar(255)
  seoDescriptionFr         String?               @db.VarChar(500)
  seoDescriptionAr         String?               @db.VarChar(500)
  publishedAt              DateTime?             @db.DateTime(3)
  suspendedAt              DateTime?             @db.DateTime(3)
  archivedAt               DateTime?             @db.DateTime(3)
  deletedAt                DateTime?             @db.DateTime(3)
  version                  Int                   @default(1)
  createdAt                DateTime              @default(now()) @db.DateTime(3)
  updatedAt                DateTime              @updatedAt @db.DateTime(3)
  brand                    Brand?                @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category                 Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants                 ProductVariant[]
  images                   ProductImage[]
  attributes               ProductAttribute[]
  suppliers                ProductSupplier[]
  promotionLinks           PromotionProduct[]
  orderItems               OrderItem[]
  restrictions             ProductRestriction[]
  sourceRecords            CatalogSourceRecord[]

  @@index([publicationStatus, publishedAt])
  @@index([categoryId, publicationStatus])
  @@index([brandId, publicationStatus])
  @@index([featured, publicationStatus])
  @@index([puffCount, publicationStatus])
  @@index([requiresPricing, requiresStock, needsMediaReview])
  @@index([deletedAt])
}

model Flavor {
  id            String           @id @default(cuid()) @db.VarChar(30)
  canonicalName String           @unique @db.VarChar(160)
  slug          String           @unique @db.VarChar(180)
  nameFr        String           @db.VarChar(160)
  nameAr        String           @db.VarChar(160)
  category      FlavorCategory
  createdAt     DateTime         @default(now()) @db.DateTime(3)
  updatedAt     DateTime         @updatedAt @db.DateTime(3)
  variants      ProductVariant[]

  @@index([category, canonicalName])
}

model ProductVariant {
  id                       String                    @id @default(cuid()) @db.VarChar(30)
  productId                String                    @db.VarChar(30)
  flavorId                 String?                   @db.VarChar(30)
  nameFr                   String                    @db.VarChar(200)
  nameAr                   String                    @db.VarChar(200)
  sku                      String                    @unique @db.VarChar(100)
  barcode                  String?                   @unique @db.VarChar(100)
  color                    String?                   @db.VarChar(100)
  nicotineStrengthMg       Decimal?                  @db.Decimal(8, 3)
  costMillimes             Int?
  priceMillimes            Int
  promotionalPriceMillimes Int?
  taxRateBps               Int                       @default(0)
  weightGrams              Int                       @default(0)
  lengthMm                 Int?
  widthMm                  Int?
  heightMm                 Int?
  lowStockThreshold        Int                       @default(0)
  publicationStatus        PublicationStatus         @default(DRAFT)
  sortOrder                Int                       @default(0)
  archivedAt               DateTime?                 @db.DateTime(3)
  deletedAt                DateTime?                 @db.DateTime(3)
  version                  Int                       @default(1)
  createdAt                DateTime                  @default(now()) @db.DateTime(3)
  updatedAt                DateTime                  @updatedAt @db.DateTime(3)
  product                  Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  flavor                   Flavor?                   @relation(fields: [flavorId], references: [id], onDelete: Restrict)
  images                   ProductImage[]
  attributes               ProductVariantAttribute[]
  batches                  ProductBatch[]
  inventoryItems           InventoryItem[]
  cartItems                CartItem[]
  wishlistItems            WishlistItem[]
  orderItems               OrderItem[]
  sourceRecords            CatalogSourceRecord[]

  @@index([productId, publicationStatus, sortOrder])
  @@index([flavorId, publicationStatus])
  @@index([nicotineStrengthMg, publicationStatus])
  @@index([publicationStatus, deletedAt])
}

model ProductImage {
  id               String                @id @default(cuid()) @db.VarChar(30)
  productId        String?               @db.VarChar(30)
  variantId        String?               @db.VarChar(30)
  objectKey        String                @db.VarChar(1024)
  objectKeyHash    String                @unique @db.Char(64)
  bucket           String                @db.VarChar(120)
  contentType      String                @db.VarChar(100)
  originalFilename String?               @db.VarChar(255)
  byteSize         Int
  checksumSha256   String                @db.Char(64)
  width            Int?
  height           Int?
  altTextFr        String                @db.VarChar(300)
  altTextAr        String                @db.VarChar(300)
  sortOrder        Int                   @default(0)
  isPrimary        Boolean               @default(false)
  moderationStatus ImageModerationStatus @default(PENDING)
  createdAt        DateTime              @default(now()) @db.DateTime(3)
  updatedAt        DateTime              @updatedAt @db.DateTime(3)
  deletedAt        DateTime?             @db.DateTime(3)
  product          Product?              @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  variant          ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceRecords    CatalogSourceRecord[]

  @@index([productId, sortOrder])
  @@index([variantId, sortOrder])
  @@index([checksumSha256])
  @@index([moderationStatus, createdAt])
}

model CatalogImportBatch {
  id              String              @id @default(cuid()) @db.VarChar(30)
  importKey       String              @db.VarChar(100)
  dryRun          Boolean
  payloadHash     String              @db.Char(64)
  format          CatalogImportFormat
  source          CatalogImportSource
  schemaVersion   String              @db.VarChar(20)
  status          CatalogImportStatus
  partialMode     Boolean             @default(false)
  overridePrice   Boolean             @default(false)
  overrideStatus  Boolean             @default(false)
  overrideImages  Boolean             @default(false)
  rowCount        Int
  appliedCount    Int                 @default(0)
  payload         Json?
  result          Json
  previewBatchId  String?             @db.VarChar(30)
  createdByUserId String              @db.VarChar(30)
  createdAt       DateTime            @default(now()) @db.DateTime(3)
  completedAt     DateTime?           @db.DateTime(3)
  rolledBackAt    DateTime?           @db.DateTime(3)
  rows            CatalogImportRow[]

  @@unique([importKey, dryRun])
  @@index([createdByUserId, createdAt])
  @@index([status, createdAt])
  @@index([previewBatchId])
}

model CatalogImportRow {
  id                 String                 @id @default(cuid()) @db.VarChar(30)
  batchId            String                 @db.VarChar(30)
  rowNumber          Int
  stableIdentity     String                 @db.VarChar(320)
  payloadHash        String                 @db.Char(64)
  status             CatalogImportRowStatus
  action             String                 @db.VarChar(40)
  issues             Json
  beforeSnapshot     Json?
  afterSnapshot      Json?
  productId          String?                @db.VarChar(30)
  variantId          String?                @db.VarChar(30)
  productPostVersion Int?
  postVersion        Int?
  createdAt          DateTime               @default(now()) @db.DateTime(3)
  batch              CatalogImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@index([stableIdentity])
  @@index([productId])
  @@index([variantId])
}

model CatalogSourceRecord {
  id            String                  @id @default(cuid()) @db.VarChar(30)
  source        CatalogImportSource
  entityType    CatalogSourceEntityType
  externalKey   String                  @db.VarChar(320)
  sourceUrl     String                  @db.VarChar(2048)
  sourceUrlHash String                  @db.Char(64)
  contentHash   String?                 @db.Char(64)
  verifiedAt    DateTime?               @db.DateTime(3)
  metadata      Json?
  productId     String?                 @db.VarChar(30)
  variantId     String?                 @db.VarChar(30)
  imageId       String?                 @db.VarChar(30)
  createdAt     DateTime                @default(now()) @db.DateTime(3)
  updatedAt     DateTime                @updatedAt @db.DateTime(3)
  product       Product?                @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  variant       ProductVariant?         @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  image         ProductImage?           @relation(fields: [imageId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([source, entityType, externalKey])
  @@index([sourceUrlHash])
  @@index([productId])
  @@index([variantId])
  @@index([imageId])
}

model ProductAttribute {
  id        String                  @id @default(cuid()) @db.VarChar(30)
  productId String                  @db.VarChar(30)
  key       String                  @db.VarChar(80)
  nameFr    String                  @db.VarChar(120)
  nameAr    String                  @db.VarChar(120)
  sortOrder Int                     @default(0)
  product   Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductAttributeValue[]

  @@unique([productId, key])
  @@index([productId, sortOrder])
}

model ProductAttributeValue {
  id          String                    @id @default(cuid()) @db.VarChar(30)
  attributeId String                    @db.VarChar(30)
  valueFr     String                    @db.VarChar(160)
  valueAr     String                    @db.VarChar(160)
  sortOrder   Int                       @default(0)
  attribute   ProductAttribute          @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants    ProductVariantAttribute[]

  @@unique([attributeId, valueFr])
  @@index([attributeId, sortOrder])
}

model ProductVariantAttribute {
  variantId        String                @db.VarChar(30)
  attributeValueId String                @db.VarChar(30)
  variant          ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue   ProductAttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
}

model Supplier {
  id            String            @id @default(cuid()) @db.VarChar(30)
  name          String            @db.VarChar(200)
  code          String            @unique @db.VarChar(80)
  status        SupplierStatus    @default(ACTIVE)
  contactName   String?           @db.VarChar(160)
  phoneE164     String?           @db.VarChar(16)
  email         String?           @db.VarChar(320)
  taxIdentifier String?           @db.VarChar(100)
  address       String?           @db.VarChar(500)
  notes         String?           @db.Text
  createdAt     DateTime          @default(now()) @db.DateTime(3)
  updatedAt     DateTime          @updatedAt @db.DateTime(3)
  products      ProductSupplier[]
  batches       ProductBatch[]

  @@index([status, name])
}

model ProductSupplier {
  productId            String   @db.VarChar(30)
  supplierId           String   @db.VarChar(30)
  supplierReference    String?  @db.VarChar(160)
  supplierCostMillimes Int?
  preferred            Boolean  @default(false)
  leadTimeDays         Int?
  createdAt            DateTime @default(now()) @db.DateTime(3)
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier             Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@id([productId, supplierId])
  @@index([supplierId, preferred])
}

model ProductBatch {
  id                String          @id @default(cuid()) @db.VarChar(30)
  variantId         String          @db.VarChar(30)
  supplierId        String?         @db.VarChar(30)
  batchNumber       String          @db.VarChar(120)
  supplierReference String?         @db.VarChar(160)
  manufacturedAt    DateTime?       @db.Date
  expiryDate        DateTime?       @db.Date
  receivedAt        DateTime?       @db.DateTime(3)
  archivedAt        DateTime?       @db.DateTime(3)
  createdAt         DateTime        @default(now()) @db.DateTime(3)
  variant           ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  supplier          Supplier?       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  inventoryItems    InventoryItem[]
  stockMovements    StockMovement[]

  @@unique([variantId, batchNumber])
  @@index([expiryDate, archivedAt])
  @@index([supplierId, supplierReference])
}

// Inventory

enum StockMovementType {
  INITIAL_STOCK
  PURCHASE_RECEIPT
  MANUAL_ADJUSTMENT
  RESERVATION
  RESERVATION_RELEASE
  ORDER_CONFIRMED
  ORDER_CANCELLED
  DELIVERY_REFUSED_RETURN
  DELIVERY_FAILED_RETURN
  CUSTOMER_RETURN
  DAMAGE
  EXPIRY
  TRANSFER_IN
  TRANSFER_OUT
}

enum StockReservationState {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum StockReservationSource {
  CART
  CHECKOUT
  ORDER
}

enum InventoryAdjustmentStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  APPLIED
  EXPIRED
}

model InventoryLocation {
  id              String           @id @default(cuid()) @db.VarChar(30)
  code            String           @unique @db.VarChar(80)
  name            String           @db.VarChar(160)
  address         String?          @db.VarChar(500)
  active          Boolean          @default(true)
  fulfillsOrders  Boolean          @default(true)
  createdAt       DateTime         @default(now()) @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @db.DateTime(3)
  inventoryItems  InventoryItem[]
  movements       StockMovement[]
  pickupLocations PickupLocation[]
}

model InventoryItem {
  id             String                @id @default(cuid()) @db.VarChar(30)
  variantId      String                @db.VarChar(30)
  locationId     String                @db.VarChar(30)
  batchId        String?               @db.VarChar(30)
  lotKey         String                @default("UNBATCHED") @db.VarChar(120)
  onHandQuantity Int                   @default(0)
  version        Int                   @default(1)
  createdAt      DateTime              @default(now()) @db.DateTime(3)
  updatedAt      DateTime              @updatedAt @db.DateTime(3)
  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location       InventoryLocation     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  batch          ProductBatch?         @relation(fields: [batchId], references: [id], onDelete: Restrict)
  movements      StockMovement[]
  reservations   StockReservation[]
  adjustments    InventoryAdjustment[]
  transfersOut   InventoryTransfer[]   @relation("InventoryTransferSource")
  transfersIn    InventoryTransfer[]   @relation("InventoryTransferDestination")

  @@unique([variantId, locationId, lotKey])
  @@index([variantId, locationId])
  @@index([locationId, onHandQuantity])
  @@index([batchId])
}

model StockMovement {
  id                 String             @id @default(cuid()) @db.VarChar(30)
  inventoryItemId    String             @db.VarChar(30)
  locationId         String             @db.VarChar(30)
  batchId            String?            @db.VarChar(30)
  type               StockMovementType
  quantityDelta      Int
  onHandAfter        Int
  referenceType      String?            @db.VarChar(80)
  referenceId        String?            @db.VarChar(30)
  reasonCode         String?            @db.VarChar(80)
  note               String?            @db.VarChar(1000)
  actorUserId        String?            @db.VarChar(30)
  requestId          String?            @db.VarChar(100)
  idempotencyKeyHash String?            @unique @db.Char(64)
  requestFingerprint String?            @db.Char(64)
  occurredAt         DateTime           @default(now()) @db.DateTime(3)
  inventoryItem      InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  location           InventoryLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  batch              ProductBatch?      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  transferOut        InventoryTransfer? @relation("InventoryTransferSourceMovement")
  transferIn         InventoryTransfer? @relation("InventoryTransferDestinationMovement")

  @@index([inventoryItemId, occurredAt])
  @@index([type, occurredAt])
  @@index([referenceType, referenceId])
}

model StockReservation {
  id              String                 @id @default(cuid()) @db.VarChar(30)
  inventoryItemId String                 @db.VarChar(30)
  sourceType      StockReservationSource
  sourceId        String                 @db.VarChar(30)
  activeKey       String?                @unique @db.VarChar(191)
  quantity        Int
  state           StockReservationState  @default(ACTIVE)
  orderId         String?                @db.VarChar(30)
  orderItemId     String?                @db.VarChar(30)
  expiresAt       DateTime               @db.DateTime(3)
  consumedAt      DateTime?              @db.DateTime(3)
  releasedAt      DateTime?              @db.DateTime(3)
  releaseReason   String?                @db.VarChar(255)
  createdAt       DateTime               @default(now()) @db.DateTime(3)
  updatedAt       DateTime               @updatedAt @db.DateTime(3)
  inventoryItem   InventoryItem          @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  order           Order?                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem       OrderItem?             @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId, state, expiresAt])
  @@index([state, expiresAt])
  @@index([sourceType, sourceId])
  @@index([orderId])
}

model InventoryAdjustment {
  id              String                    @id @default(cuid()) @db.VarChar(30)
  inventoryItemId String                    @db.VarChar(30)
  quantityDelta   Int
  reasonCode      String                    @db.VarChar(80)
  note            String?                   @db.VarChar(1000)
  status          InventoryAdjustmentStatus @default(PENDING_APPROVAL)
  requestedBy     String                    @db.VarChar(30)
  approvedBy      String?                   @db.VarChar(30)
  decisionReason  String?                   @db.VarChar(500)
  expectedVersion Int                       @default(1)
  onHandBefore    Int                       @default(0)
  requestedAt     DateTime                  @default(now()) @db.DateTime(3)
  expiresAt       DateTime?                 @db.DateTime(3)
  decidedAt       DateTime?                 @db.DateTime(3)
  appliedAt       DateTime?                 @db.DateTime(3)
  stockMovementId String?                   @unique @db.VarChar(30)
  inventoryItem   InventoryItem             @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@index([inventoryItemId, requestedAt])
}

model InventoryTransfer {
  id                         String        @id @default(cuid()) @db.VarChar(30)
  sourceInventoryItemId      String        @db.VarChar(30)
  destinationInventoryItemId String        @db.VarChar(30)
  quantity                   Int
  idempotencyKeyHash         String        @unique @db.Char(64)
  requestFingerprint         String        @db.Char(64)
  requestedBy                String        @db.VarChar(30)
  note                       String?       @db.VarChar(1000)
  sourceMovementId           String        @unique @db.VarChar(30)
  destinationMovementId      String        @unique @db.VarChar(30)
  occurredAt                 DateTime      @default(now()) @db.DateTime(3)
  sourceInventoryItem        InventoryItem @relation("InventoryTransferSource", fields: [sourceInventoryItemId], references: [id], onDelete: Restrict)
  destinationInventoryItem   InventoryItem @relation("InventoryTransferDestination", fields: [destinationInventoryItemId], references: [id], onDelete: Restrict)
  sourceMovement             StockMovement @relation("InventoryTransferSourceMovement", fields: [sourceMovementId], references: [id], onDelete: Restrict)
  destinationMovement        StockMovement @relation("InventoryTransferDestinationMovement", fields: [destinationMovementId], references: [id], onDelete: Restrict)

  @@index([sourceInventoryItemId, occurredAt])
  @@index([destinationInventoryItemId, occurredAt])
  @@index([occurredAt, id])
}

// Cart and Wishlist

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

model Cart {
  id             String           @id @default(cuid()) @db.VarChar(30)
  customerId     String?          @db.VarChar(30)
  guestTokenHash String?          @unique @db.Char(64)
  status         CartStatus       @default(ACTIVE)
  currency       String           @default("TND") @db.Char(3)
  expiresAt      DateTime?        @db.DateTime(3)
  convertedAt    DateTime?        @db.DateTime(3)
  version        Int              @default(1)
  createdAt      DateTime         @default(now()) @db.DateTime(3)
  updatedAt      DateTime         @updatedAt @db.DateTime(3)
  customer       CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items          CartItem[]
  orders         Order[]

  @@index([customerId, status])
  @@index([status, expiresAt])
}

model CartItem {
  id        String         @id @default(cuid()) @db.VarChar(30)
  cartId    String         @db.VarChar(30)
  variantId String         @db.VarChar(30)
  quantity  Int
  createdAt DateTime       @default(now()) @db.DateTime(3)
  updatedAt DateTime       @updatedAt @db.DateTime(3)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Wishlist {
  id         String          @id @default(cuid()) @db.VarChar(30)
  customerId String          @db.VarChar(30)
  name       String          @default("default") @db.VarChar(100)
  createdAt  DateTime        @default(now()) @db.DateTime(3)
  updatedAt  DateTime        @updatedAt @db.DateTime(3)
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      WishlistItem[]

  @@unique([customerId, name])
}

model WishlistItem {
  wishlistId String         @db.VarChar(30)
  variantId  String         @db.VarChar(30)
  addedAt    DateTime       @default(now()) @db.DateTime(3)
  wishlist   Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([wishlistId, variantId])
  @@index([variantId])
}

// Promotions

enum PromotionType {
  FIXED_AMOUNT
  PERCENTAGE
  FREE_DELIVERY
}

enum PromotionStackingRule {
  EXCLUSIVE
  STACKABLE
  BEST_VALUE_ONLY
}

enum CouponStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

model Promotion {
  id                      String                @id @default(cuid()) @db.VarChar(30)
  name                    String                @db.VarChar(200)
  description             String?               @db.VarChar(1000)
  type                    PromotionType
  amountMillimes          Int?
  percentageBps           Int?
  minimumOrderMillimes    Int?
  maximumDiscountMillimes Int?
  startsAt                DateTime              @db.DateTime(3)
  endsAt                  DateTime?             @db.DateTime(3)
  globalUsageLimit        Int?
  perCustomerUsageLimit   Int?
  automatic               Boolean               @default(false)
  active                  Boolean               @default(false)
  priority                Int                   @default(0)
  stackingRule            PromotionStackingRule @default(EXCLUSIVE)
  createdAt               DateTime              @default(now()) @db.DateTime(3)
  updatedAt               DateTime              @updatedAt @db.DateTime(3)
  coupons                 Coupon[]
  products                PromotionProduct[]
  categories              PromotionCategory[]
  brands                  PromotionBrand[]
  redemptions             PromotionRedemption[]
  orderDiscounts          OrderDiscount[]

  @@index([active, startsAt, endsAt])
  @@index([automatic, priority])
}

model Coupon {
  id                    String                @id @default(cuid()) @db.VarChar(30)
  promotionId           String                @db.VarChar(30)
  code                  String                @unique @db.VarChar(100)
  status                CouponStatus          @default(ACTIVE)
  globalUsageLimit      Int?
  perCustomerUsageLimit Int?
  startsAt              DateTime?             @db.DateTime(3)
  endsAt                DateTime?             @db.DateTime(3)
  createdAt             DateTime              @default(now()) @db.DateTime(3)
  updatedAt             DateTime              @updatedAt @db.DateTime(3)
  promotion             Promotion             @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  redemptions           PromotionRedemption[]
  orderDiscounts        OrderDiscount[]

  @@index([status, startsAt, endsAt])
}

model PromotionProduct {
  promotionId String    @db.VarChar(30)
  productId   String    @db.VarChar(30)
  excluded    Boolean   @default(false)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId, excluded])
}

model PromotionCategory {
  promotionId String    @db.VarChar(30)
  categoryId  String    @db.VarChar(30)
  excluded    Boolean   @default(false)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@index([categoryId, excluded])
}

model PromotionBrand {
  promotionId String    @db.VarChar(30)
  brandId     String    @db.VarChar(30)
  excluded    Boolean   @default(false)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([promotionId, brandId])
  @@index([brandId, excluded])
}

model PromotionRedemption {
  id               String           @id @default(cuid()) @db.VarChar(30)
  promotionId      String           @db.VarChar(30)
  couponId         String?          @db.VarChar(30)
  customerId       String?          @db.VarChar(30)
  orderId          String           @db.VarChar(30)
  discountMillimes Int
  redeemedAt       DateTime         @default(now()) @db.DateTime(3)
  promotion        Promotion        @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  coupon           Coupon?          @relation(fields: [couponId], references: [id], onDelete: Restrict)
  customer         CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, promotionId, couponId])
  @@index([promotionId, redeemedAt])
  @@index([couponId, customerId, redeemedAt])
  @@index([customerId, redeemedAt])
}

// Tunisia Geography and Delivery Pricing

enum DeliveryMethodType {
  COURIER
  STORE_PICKUP
  MANUAL_QUOTE
}

enum DeliveryRateType {
  BASE
  GOVERNORATE
  DELEGATION
  LOCALITY
  REMOTE_SURCHARGE
  WEIGHT_SURCHARGE
  OVERSIZE_SURCHARGE
  EXPRESS_SURCHARGE
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Governorate {
  id             String                 @id @default(cuid()) @db.VarChar(30)
  code           String                 @unique @db.Char(2)
  nameFr         String                 @unique @db.VarChar(100)
  nameAr         String                 @db.VarChar(100)
  active         Boolean                @default(true)
  delegations    Delegation[]
  addresses      Address[]
  deliveryRates  DeliveryRate[]
  orderSnapshots OrderAddressSnapshot[]

  @@index([active, nameFr])
}

model Delegation {
  id             String                 @id @default(cuid()) @db.VarChar(30)
  governorateId  String                 @db.VarChar(30)
  code           String                 @db.VarChar(20)
  nameFr         String                 @db.VarChar(120)
  nameAr         String                 @db.VarChar(120)
  active         Boolean                @default(true)
  governorate    Governorate            @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  localities     Locality[]
  addresses      Address[]
  deliveryRates  DeliveryRate[]
  orderSnapshots OrderAddressSnapshot[]

  @@unique([governorateId, code])
  @@unique([governorateId, nameFr])
  @@index([governorateId, active, nameFr])
}

model Locality {
  id             String                 @id @default(cuid()) @db.VarChar(30)
  delegationId   String                 @db.VarChar(30)
  code           String                 @db.VarChar(30)
  nameFr         String                 @db.VarChar(160)
  nameAr         String                 @db.VarChar(160)
  active         Boolean                @default(true)
  delegation     Delegation             @relation(fields: [delegationId], references: [id], onDelete: Restrict)
  postalCodes    PostalCode[]
  addresses      Address[]
  zoneLinks      DeliveryZoneLocality[]
  deliveryRates  DeliveryRate[]
  orderSnapshots OrderAddressSnapshot[]

  @@unique([delegationId, code])
  @@index([delegationId, active, nameFr])
}

model PostalCode {
  id         String   @id @default(cuid()) @db.VarChar(30)
  localityId String   @db.VarChar(30)
  code       String   @db.Char(4)
  active     Boolean  @default(true)
  locality   Locality @relation(fields: [localityId], references: [id], onDelete: Restrict)

  @@unique([localityId, code])
  @@index([code, active])
}

model DeliveryZone {
  id                            String                 @id @default(cuid()) @db.VarChar(30)
  code                          String                 @unique @db.VarChar(80)
  nameFr                        String                 @db.VarChar(160)
  nameAr                        String                 @db.VarChar(160)
  priority                      Int                    @default(0)
  active                        Boolean                @default(true)
  supported                     Boolean                @default(true)
  temporarilySuspended          Boolean                @default(false)
  phoneConfirmationRequired     Boolean                @default(false)
  manualReviewRequired          Boolean                @default(false)
  manualQuoteAllowed            Boolean                @default(false)
  minOrderMillimes              Int?
  maxCodMillimes                Int?
  freeDeliveryThresholdMillimes Int?
  estimatedMinDays              Int?
  estimatedMaxDays              Int?
  availableDays                 Json?
  createdAt                     DateTime               @default(now()) @db.DateTime(3)
  updatedAt                     DateTime               @updatedAt @db.DateTime(3)
  localities                    DeliveryZoneLocality[]
  rates                         DeliveryRate[]
  timeWindows                   DeliveryTimeWindow[]
