  deliveryId            String                @unique @db.VarChar(30)
  deliveredAt           DateTime              @db.DateTime(3)
  recipientName         String?               @db.VarChar(200)
  recipientRelationship String?               @db.VarChar(100)
  signatureObjectKey    String?               @db.VarChar(1024)
  photoObjectKey        String?               @db.VarChar(1024)
  geolocation           Json?
  ageVerificationResult AgeVerificationResult
  cashCollectedMillimes Int?
  recordedByUserId      String?               @db.VarChar(30)
  createdAt             DateTime              @default(now()) @db.DateTime(3)
  delivery              Delivery              @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
}

