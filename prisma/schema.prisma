  payloadHash     String   @db.Char(64)
  rowCount        Int
  appliedCount    Int      @default(0)
  result          Json
  createdByUserId String   @db.VarChar(30)
  createdAt       DateTime @default(now()) @db.DateTime(3)

  @@unique([importKey, dryRun])
  @@index([createdByUserId, createdAt])
  @@index([createdAt])
