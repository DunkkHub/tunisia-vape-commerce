  cancelledAt                       DateTime?              @db.DateTime(3)
  cancellationReason                String?                @db.VarChar(500)
  version                           Int                    @default(1)
  createdAt                         DateTime               @default(now()) @db.DateTime(3)
  updatedAt                         DateTime               @updatedAt @db.DateTime(3)
  customer                          CustomerProfile?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cart                              Cart?                  @relation(fields: [cartId], references: [id], onDelete: SetNull)
  deliveryZone                      DeliveryZone?          @relation(fields: [deliveryZoneId], references: [id], onDelete: Restrict)
  deliveryRate                      DeliveryRate?          @relation(fields: [deliveryRateId], references: [id], onDelete: Restrict)
  pickupLocation                    PickupLocation?        @relation(fields: [pickupLocationId], references: [id], onDelete: Restrict)
  deliveryTimeWindow                DeliveryTimeWindow?    @relation(fields: [deliveryTimeWindowId], references: [id], onDelete: Restrict)
  items                             OrderItem[]
  addressSnapshots                  OrderAddressSnapshot[]
  statusHistory                     OrderStatusHistory[]
  notes                             OrderNote[]
  consentSnapshots                  OrderConsentSnapshot[]
  discounts                         OrderDiscount[]
  idempotencyKey                    OrderIdempotencyKey?
  reservations                      StockReservation[]
  promotionRedemptions              PromotionRedemption[]
  delivery                          Delivery?
  cashCollections                   CashCollection[]
  cashDiscrepancies                 CashDiscrepancy[]
  returnRequests                    ReturnRequest[]
  notifications                     Notification[]
  consentRecords                    ConsentRecord[]
  ageVerificationEvents             AgeVerificationEvent[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([customerPhoneSnapshot, createdAt])
  @@index([deliveryZoneId, createdAt])
}

model OrderItem {
  id                   String             @id @default(cuid()) @db.VarChar(30)
