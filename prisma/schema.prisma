  publishedAt      DateTime?         @db.DateTime(3)
  publishedJobId   String?           @db.VarChar(191)
  processedAt      DateTime?         @db.DateTime(3)
  deadLetteredAt   DateTime?         @db.DateTime(3)
  safeErrorCode    String?           @db.VarChar(100)
  createdAt        DateTime          @default(now()) @db.DateTime(3)
  updatedAt        DateTime          @updatedAt @db.DateTime(3)

  @@index([status, availableAt, id])
  @@index([status, leaseExpiresAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([eventType, createdAt])
}

model SystemHealthRecord {
  id         String             @id @default(cuid()) @db.VarChar(30)
  component  String             @db.VarChar(120)
  instanceId String             @db.VarChar(160)
  status     SystemHealthStatus
  latencyMs  Int?
  details    Json?
  checkedAt  DateTime           @default(now()) @db.DateTime(3)

  @@index([component, checkedAt])
  @@index([status, checkedAt])
  @@index([instanceId, checkedAt])
}
