  SUSPENDED
  ARCHIVED
}

enum CourierIntegrationType {
  MANUAL
  API
  CSV
}

enum DeliveryStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  ON_HOLD
  PREPARING
  READY_FOR_PICKUP
  ASSIGNED_TO_COURIER
  HANDED_TO_COURIER
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERY_ATTEMPTED
  RESCHEDULED
  DELIVERED
  REFUSED
  FAILED
  RETURN_TO_SENDER
  RETURNED
  CANCELLED
}

enum DeliveryAttemptOutcome {
  DELIVERED
  CUSTOMER_UNAVAILABLE
  ADDRESS_NOT_FOUND
  CUSTOMER_REFUSED
  FAILED_AGE_VERIFICATION
  PARTIAL_CASH_NOT_ALLOWED
  RESCHEDULED
  OTHER_FAILED
}

enum AgeVerificationResult {
  NOT_REQUIRED
  PENDING
  PASSED
  FAILED
  REFUSED
  UNABLE_TO_VERIFY
}

enum ManifestStatus {
  DRAFT
  SEALED
  HANDED_OVER
  CLOSED
  CANCELLED
}

model Courier {
  id              String               @id @default(cuid()) @db.VarChar(30)
  code            String               @unique @db.VarChar(80)
  name            String               @db.VarChar(200)
  status          CourierStatus        @default(ACTIVE)
  contactName     String?              @db.VarChar(160)
  phoneE164       String?              @db.VarChar(16)
  email           String?              @db.VarChar(320)
  feeRules        Json?
  notes           String?              @db.Text
  createdAt       DateTime             @default(now()) @db.DateTime(3)
  updatedAt       DateTime             @updatedAt @db.DateTime(3)
  users           CourierUser[]
  integrations    CourierIntegration[]
  deliveries      Delivery[]
  manifests       DeliveryManifest[]
  cashCollections CashCollection[]
  cashRemittances CashRemittance[]

  @@index([status, name])
}

model CourierUser {
  courierId String   @db.VarChar(30)
  userId    String   @db.VarChar(30)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.DateTime(3)
  courier   Courier  @relation(fields: [courierId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([courierId, userId])
  @@index([userId, active])
}

model CourierIntegration {
  id                   String                 @id @default(cuid()) @db.VarChar(30)
  courierId            String                 @db.VarChar(30)
  type                 CourierIntegrationType
  name                 String                 @db.VarChar(160)
  active               Boolean                @default(false)
  encryptedCredentials String?                @db.LongText
  configuration        Json?
  lastHealthCheckAt    DateTime?              @db.DateTime(3)
  createdAt            DateTime               @default(now()) @db.DateTime(3)
  updatedAt            DateTime               @updatedAt @db.DateTime(3)
  courier              Courier                @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([courierId, active])
}

model Delivery {
  id                      String                 @id @default(cuid()) @db.VarChar(30)
  orderId                 String                 @unique @db.VarChar(30)
  courierId               String?                @db.VarChar(30)
  status                  DeliveryStatus         @default(PENDING_CONFIRMATION)
  trackingNumber          String?                @unique @db.VarChar(120)
  courierFeeMillimes      Int?
  assignedAt              DateTime?              @db.DateTime(3)
  handedToCourierAt       DateTime?              @db.DateTime(3)
  deliveredAt             DateTime?              @db.DateTime(3)
  nextAttemptAt           DateTime?              @db.DateTime(3)
  internalNotes           String?                @db.Text
  customerVisibleNotes    String?                @db.Text
  ageVerificationRequired Boolean                @default(false)
  ageVerificationResult   AgeVerificationResult  @default(NOT_REQUIRED)
  cashCollectedResult     Boolean?
  version                 Int                    @default(1)
  createdAt               DateTime               @default(now()) @db.DateTime(3)
  updatedAt               DateTime               @updatedAt @db.DateTime(3)
  order                   Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  courier                 Courier?               @relation(fields: [courierId], references: [id], onDelete: Restrict)
  attempts                DeliveryAttempt[]
  events                  DeliveryEvent[]
  manifestItems           DeliveryManifestItem[]
  shippingLabels          ShippingLabel[]
  proofOfDelivery         ProofOfDelivery?
  cashCollections         CashCollection[]
  ageVerificationEvents   AgeVerificationEvent[]
  returnRequests          ReturnRequest[]

  @@index([courierId, status, createdAt])
  @@index([status, nextAttemptAt])
}

model DeliveryAttempt {
  id                    String                 @id @default(cuid()) @db.VarChar(30)
  deliveryId            String                 @db.VarChar(30)
  attemptNumber         Int
  attemptedAt           DateTime               @db.DateTime(3)
  outcome               DeliveryAttemptOutcome
  notes                 String?                @db.VarChar(1000)
  nextAttemptAt         DateTime?              @db.DateTime(3)
  ageVerificationResult AgeVerificationResult  @default(NOT_REQUIRED)
  cashExpectedMillimes  Int?
  cashCollectedMillimes Int?
  recordedByUserId      String?                @db.VarChar(30)
  createdAt             DateTime               @default(now()) @db.DateTime(3)
  delivery              Delivery               @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@unique([deliveryId, attemptNumber])
  @@index([outcome, attemptedAt])
}

model DeliveryEvent {
  id          String          @id @default(cuid()) @db.VarChar(30)
  deliveryId  String          @db.VarChar(30)
  fromStatus  DeliveryStatus?
  toStatus    DeliveryStatus
  occurredAt  DateTime        @default(now()) @db.DateTime(3)
  actorUserId String?         @db.VarChar(30)
  source      String          @db.VarChar(80)
  reasonCode  String?         @db.VarChar(80)
  note        String?         @db.VarChar(1000)
  payload     Json?
  requestId   String?         @db.VarChar(100)
  delivery    Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@index([deliveryId, occurredAt])
  @@index([toStatus, occurredAt])
}

model DeliveryManifest {
  id             String                 @id @default(cuid()) @db.VarChar(30)
  manifestNumber String                 @unique @db.VarChar(60)
  courierId      String                 @db.VarChar(30)
  status         ManifestStatus         @default(DRAFT)
  manifestDate   DateTime               @db.Date
  createdBy      String                 @db.VarChar(30)
  sealedAt       DateTime?              @db.DateTime(3)
  handedOverAt   DateTime?              @db.DateTime(3)
  closedAt       DateTime?              @db.DateTime(3)
  createdAt      DateTime               @default(now()) @db.DateTime(3)
  courier        Courier                @relation(fields: [courierId], references: [id], onDelete: Restrict)
