# Runtime
NODE_ENV=development
PORT=3000

# Browser and API URLs
WEB_URL=http://localhost:5173
ADMIN_WEB_URL=http://localhost:5173
COMPOSE_WEB_URL=http://localhost:8080
COMPOSE_ADMIN_WEB_URL=http://localhost:8080
API_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000/api/v1
VITE_API_URL=
# CORS is derived as an exact allowlist from WEB_URL and ADMIN_WEB_URL.
OPENAPI_ENABLED=true

# MySQL. These placeholders are local-only and must be replaced outside development.
MYSQL_DATABASE=vape_store
# Loopback port for host tools. 13306 avoids a common collision with XAMPP on 3306.
MYSQL_PORT=13306
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_APP_PASSWORD=change_me
MYSQL_MIGRATION_PASSWORD=change_me
DATABASE_URL=mysql://app_user:change_me@mysql:3306/vape_store
DATABASE_MIGRATION_URL=mysql://migration_user:change_me@mysql:3306/vape_store
# Required only by integration tests; must target a disposable test server with CREATE DATABASE.
TEST_DATABASE_ADMIN_URL=
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_QUERY_TIMEOUT_MS=10000

# Redis. Use an authenticated TLS URL outside local development.
REDIS_URL=redis://redis:6379
# Integration tests require a dedicated logical database and enforce database 15.
TEST_REDIS_URL=redis://127.0.0.1:6379/15
# The real-browser operational E2E suite uses and flushes a separate database 14.
TEST_E2E_REDIS_URL=redis://127.0.0.1:6379/14
RATE_LIMIT_REDIS_PREFIX=vape-store
CUSTOMER_SESSION_REDIS_PREFIX=vape-store:session:customer
ADMIN_SESSION_REDIS_PREFIX=vape-store:session:admin
QUEUE_REDIS_PREFIX=vape-store:queue

# Readiness probes. Keep the expected migration synchronized with the deployed image.
HEALTHCHECK_TIMEOUT_MS=2000
WORKER_HEARTBEAT_MAX_AGE_SECONDS=60
WORKER_HEALTHCHECK_MAX_AGE_SECONDS=60
EXPECTED_MIGRATION_NAME=20260804090000_customer_google_identity

# Authentication. Generate independent high-entropy values; never reuse them.
SESSION_SECRET=
COOKIE_SECRET=
FIELD_ENCRYPTION_KEY=
CUSTOMER_SESSION_COOKIE_NAME=vape_customer_session
CUSTOMER_CSRF_COOKIE_NAME=vape_customer_csrf
ADMIN_PREAUTH_COOKIE_NAME=vape_admin_pre_auth
ADMIN_SESSION_COOKIE_NAME=vape_admin_session
ADMIN_CSRF_COOKIE_NAME=vape_admin_csrf
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CUSTOMER_SESSION_IDLE_MINUTES=10080
CUSTOMER_SESSION_ABSOLUTE_MINUTES=43200
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_ABSOLUTE_MINUTES=480
ADMIN_PREAUTH_TTL_MINUTES=5
ADMIN_RECENT_AUTH_MINUTES=10
ADMIN_IP_ALLOWLIST=
PASSWORD_RESET_TTL_MINUTES=30
# Customer-only Google OAuth. Keep disabled until all three provider values are provisioned.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GOOGLE_OAUTH_STATE_TTL_SECONDS=300
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# S3-compatible object storage / MinIO
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_ROOT=uploads/media
MINIO_ROOT_USER=minio_local_admin
MINIO_ROOT_PASSWORD=change_me_minio
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=vape-store
S3_ACCESS_KEY=minio_local_admin
S3_SECRET_KEY=change_me_minio
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PIXELS=40000000
# Exact HTTPS hostnames permitted for operator-uploaded catalogue image URLs.
# Leave empty to disable generic remote-media downloads. Official Wotofo hosts use a separate allowlist.
CATALOG_IMPORT_MEDIA_HOSTS=
# Local mail and notification adapters
NOTIFICATION_ADAPTER=smtp
NOTIFICATION_BRIDGE_ENABLED=true
SMS_ENABLED=false
NOTIFICATION_CONNECT_TIMEOUT_MS=5000
NOTIFICATION_REQUEST_TIMEOUT_MS=10000
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@local.test
EMAIL_FROM_NAME=Tunisia Vape Commerce
SMS_WEBHOOK_URL=
SMS_WEBHOOK_AUTH_TOKEN=
SMS_SENDER=TunisiaVape

# Store and locale
STORE_NAME=
STORE_PHONE=
STORE_EMAIL=
STORE_ADDRESS=
DEFAULT_LOCALE=fr
SUPPORTED_LOCALES=fr,ar
CURRENCY=TND
TIMEZONE=Africa/Tunis

# Launch and operational gates
MINIMUM_PURCHASE_AGE=18
CHECKOUT_ENABLED=true
MAINTENANCE_MODE=false
PRELAUNCH_MODE=false
AGE_VERIFICATION_AT_DELIVERY=true

# Logging, telemetry and provider integration
LOG_LEVEL=info
OTEL_SERVICE_NAME=tunisia-vape-commerce
OTEL_EXPORTER_OTLP_ENDPOINT=
ERROR_MONITORING_DSN=
COURIER_PROVIDER=manual

# Backup and isolated-restore scripts. Use dedicated least-privilege identities.
DATABASE_BACKUP_URL=
DATABASE_RESTORE_URL=
BACKUP_ENCRYPTION_KEY_BASE64=
BACKUP_ENCRYPTION_KEY_ID=
BACKUP_ENVIRONMENT=
BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=35
BACKUP_ENCRYPTION_MODE=aes-256-gcm
ALLOW_UNENCRYPTED_BACKUP=false
RESTORE_TARGET_IS_DISPOSABLE=false
RESTORE_CONFIRM_DATABASE=
RESTORE_ALLOW_UNENCRYPTED_BACKUP=false
RESTORE_ALLOW_LEGACY_UNSIGNED_MANIFEST=false
RESTORE_MAX_PLAINTEXT_BYTES=1099511627776
RESTORE_DRILL_ADMIN_URL=
RESTORE_DRILL_TARGET_IS_ISOLATED=false
RESTORE_DRILL_CONFIRM_HOST=
RESTORE_DRILL_DATABASE_PREFIX=vape_restore_drill
RESTORE_DRILL_KEEP_DATABASE=false
RESTORE_DRILL_REPORT_DIRECTORY=backups/restore-drill-reports
MYSQLDUMP_BIN=mysqldump
MYSQL_BIN=mysql
MYSQL_TLS_MODE=PREFERRED
MYSQL_TLS_CA_FILE=

# Read-only post-deployment smoke test. HTTPS is required outside loopback unless explicitly allowed.
SMOKE_WEB_URL=http://127.0.0.1:8080
SMOKE_ADMIN_WEB_URL=http://127.0.0.1:8080
SMOKE_API_URL=http://127.0.0.1:3000/api/v1
SMOKE_TIMEOUT_MS=10000
SMOKE_EXPECT_CHECKOUT_ENABLED=true
SMOKE_REQUIRE_CHECKOUT_READY=true
SMOKE_ALLOW_INSECURE_HTTP=false

# Production Compose secret-file inputs. Keep the files outside the repository.
MYSQL_ROOT_PASSWORD_FILE=
MYSQL_APP_PASSWORD_FILE=
MYSQL_MIGRATION_PASSWORD_FILE=
REDIS_PASSWORD_FILE=

# Edge hostnames are examples; production requires distinct approved DNS and TLS.
STOREFRONT_HOST=localhost
ADMIN_HOST=admin.localhost
