# Runtime
NODE_ENV=development
PORT=3000

# Browser and API URLs
WEB_URL=http://localhost:5173
ADMIN_WEB_URL=http://localhost:5173
COMPOSE_WEB_URL=http://localhost:8080
API_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000/api/v1
VITE_API_URL=
CORS_ORIGINS=http://localhost:5173

# MySQL. These placeholders are local-only and must be replaced outside development.
MYSQL_DATABASE=vape_store
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_APP_PASSWORD=change_me
MYSQL_MIGRATION_PASSWORD=change_me
TEST_DATABASE_ADMIN_URL: mysql://root:ci_root_password@127.0.0.1:3306
TEST_REDIS_URL: redis://127.0.0.1:6379/15
DATABASE_URL=mysql://app_user:change_me@mysql:3306/vape_store
DATABASE_MIGRATION_URL=mysql://migration_user:change_me@mysql:3306/vape_store
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_QUERY_TIMEOUT_MS=10000

# Redis. Use an authenticated TLS URL outside local development.
REDIS_URL=redis://redis:6379
RATE_LIMIT_REDIS_PREFIX=vape-store
CUSTOMER_SESSION_REDIS_PREFIX=vape-store:session:customer
ADMIN_SESSION_REDIS_PREFIX=vape-store:session:admin
QUEUE_REDIS_PREFIX=vape-store:queue

# Authentication. Generate independent high-entropy values; never reuse them.
SESSION_SECRET=
COOKIE_SECRET=
FIELD_ENCRYPTION_KEY=
CUSTOMER_SESSION_COOKIE_NAME=vape_customer_session
CUSTOMER_CSRF_COOKIE_NAME=vape_customer_csrf
ADMIN_PREAUTH_COOKIE_NAME=vape_admin_pre_auth
ADMIN_SESSION_COOKIE_NAME=vape_admin_session
ADMIN_CSRF_COOKIE_NAME=vape_admin_csrf
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CUSTOMER_SESSION_IDLE_MINUTES=10080
CUSTOMER_SESSION_ABSOLUTE_MINUTES=43200
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_ABSOLUTE_MINUTES=480
ADMIN_PREAUTH_TTL_MINUTES=5
ADMIN_RECENT_AUTH_MINUTES=10
ADMIN_IP_ALLOWLIST=
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# S3-compatible object storage / MinIO
MINIO_ROOT_USER=minio_local_admin
MINIO_ROOT_PASSWORD=change_me_minio
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=vape-store
S3_ACCESS_KEY=minio_local_admin
S3_SECRET_KEY=change_me_minio
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PIXELS=40000000
MALWARE_SCANNER_ENABLED=false

# Local mail and notification adapters
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER=

# Store and locale
STORE_NAME=
STORE_PHONE=
STORE_EMAIL=
STORE_ADDRESS=
DEFAULT_LOCALE=fr
SUPPORTED_LOCALES=fr,ar
CURRENCY=TND
TIMEZONE=Africa/Tunis

# Closed-by-default legal and operational gates
MINIMUM_PURCHASE_AGE=
LEGAL_REVIEW_COMPLETED=false
CHECKOUT_ENABLED=false
MAINTENANCE_MODE=false
PRELAUNCH_MODE=true
AGE_VERIFICATION_AT_DELIVERY=true

# Logging, telemetry and provider integration
LOG_LEVEL=info
OTEL_SERVICE_NAME=tunisia-vape-commerce
OTEL_EXPORTER_OTLP_ENDPOINT=
ERROR_MONITORING_DSN=
COURIER_PROVIDER=manual

# Backup scripts. Value must decode to exactly 32 random bytes.
BACKUP_ENCRYPTION_KEY_BASE64=
MYSQLDUMP_BIN=mysqldump
MYSQL_BIN=mysql

# Edge hostnames are examples; production uses approved DNS and TLS.
STORE_HOST=localhost
ADMIN_HOST=admin.localhost
