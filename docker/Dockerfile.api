# syntax=docker/dockerfile:1.7
ARG NODE_IMAGE=node:24-alpine

FROM ${NODE_IMAGE} AS build
ENV PNPM_HOME=/pnpm
ENV PATH=/pnpm:${PATH}
WORKDIR /workspace
RUN apk add --no-cache python3 make g++ openssl libc6-compat dumb-init
RUN corepack enable && corepack prepare pnpm@11.11.0 --activate
COPY . .
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store pnpm install --frozen-lockfile
RUN pnpm prisma:generate
RUN pnpm --filter @vape/api... build
RUN pnpm --filter @vape/api deploy --prod --legacy /opt/api
RUN pnpm --filter @vape/migration-runtime deploy --prod --legacy /opt/migration
RUN cp prisma/schema.prisma /opt/api/prisma.schema \
  && cd /opt/api \
  && node /workspace/node_modules/prisma/build/index.js generate --schema=prisma.schema \
  && rm prisma.schema

FROM ${NODE_IMAGE} AS migration
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
RUN apk add --no-cache dumb-init openssl libstdc++
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /opt/migration ./
COPY --from=build --chown=node:node /workspace/prisma ./prisma
USER node
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "node_modules/prisma/build/index.js", "migrate", "deploy", "--schema=/app/prisma/schema.prisma"]

FROM ${NODE_IMAGE} AS runtime
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
RUN apk add --no-cache dumb-init openssl libstdc++
ENV NODE_ENV=production
ENV PORT=3000
WORKDIR /app
COPY --from=build --chown=node:node /opt/api ./api
COPY --from=build --chown=node:node /workspace/prisma ./prisma
USER node
EXPOSE 3000
HEALTHCHECK --interval=20s --timeout=3s --start-period=20s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1:3000/api/v1/health/live || exit 1
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "api/dist/main.js"]
