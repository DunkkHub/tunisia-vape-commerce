upstream vape_api {
    server api:3000;
    keepalive 64;
}

upstream vape_web {
    server web:8080;
    keepalive 32;
}

server {
    listen 8080;
    listen [::]:8080;
    server_name ${STOREFRONT_HOST};
    server_tokens off;

    client_max_body_size 10m;
    client_body_timeout 15s;
    keepalive_timeout 30s;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'" always;

    # The public virtual host never forwards administrator UI, API, authentication, or docs.
    location ~* ^/admin(?:/|$) {
        return 404;
    }

    location ~* ^/api/v1/(?:admin(?:/|$)|auth/admin(?:/|$)) {
        return 404;
    }

    location ~* ^/api/docs(?:/|$|-) {
        return 404;
    }

    location /api/ {
        proxy_http_version 1.1;
        proxy_pass http://vape_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_connect_timeout 3s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_buffering off;
    }

    location / {
        proxy_http_version 1.1;
        proxy_pass http://vape_web;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 8080;
    listen [::]:8080;
    server_name ${ADMIN_HOST};
    server_tokens off;

    client_max_body_size 10m;
    client_body_timeout 15s;
    keepalive_timeout 30s;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'" always;

    # Customer authentication is served only by the storefront virtual host.
    location ~* ^/api/v1/auth/customer(?:/|$) {
        return 404;
    }

    # A reviewed media batch is bounded and protected by a Redis execution lock. Only this exact
    # administrator route receives the longer response timeout; ordinary APIs retain 30 seconds.
    location ~ ^/api/v1/admin/catalog/imports/[^/]+/media/apply$ {
        proxy_http_version 1.1;
        proxy_pass http://vape_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_connect_timeout 3s;
        proxy_send_timeout 30s;
        proxy_read_timeout 7200s;
        proxy_buffering off;
    }

    location /api/ {
        proxy_http_version 1.1;
        proxy_pass http://vape_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_connect_timeout 3s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_buffering off;
    }

    location / {
        proxy_http_version 1.1;
        proxy_pass http://vape_web;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 8080 default_server;
    listen [::]:8080 default_server;
    server_name _;
    return 444;
}
