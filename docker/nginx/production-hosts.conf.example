upstream vape_api_production {
    server api:3000;
    keepalive 64;
}

upstream vape_web_production {
    server web:8080;
    keepalive 32;
}

# Historical TLS-edge example. The executable Compose baseline is
# production-gateway.conf.template; keep these same route-denial rules if TLS is
# terminated directly in Nginx instead of at an upstream ingress.
server {
    listen 443 ssl;
    server_name store.example.tn;

    location ^~ /admin {
        return 404;
    }

    location ^~ /api/v1/auth/admin/ {
        return 404;
    }

    location ^~ /api/v1/admin/ {
        return 404;
    }

    location ~* ^/api/docs(?:/|$|-) {
        return 404;
    }

    location /api/ {
        proxy_pass http://vape_api_production;
    }

    location / {
        proxy_pass http://vape_web_production;
    }
}

server {
    listen 443 ssl;
    server_name admin.example.tn;

    location ^~ /api/v1/auth/customer/ {
        return 404;
    }

    location /api/ {
        proxy_pass http://vape_api_production;
    }

    location / {
        proxy_pass http://vape_web_production;
    }
}
