{
  "name": "tunisia-vape-commerce",
  "version": "0.1.0",
  "private": true,
  "description": "Age-restricted, cash-on-delivery commerce platform for a controlled Tunisian staging environment.",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @vape/web --filter @vape/api --filter @vape/worker dev",
    "dev:web": "pnpm --filter @vape/web dev",
    "dev:api": "pnpm --filter @vape/api dev",
    "dev:worker": "pnpm --filter @vape/worker dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @vape/web build",
    "build:api": "pnpm --filter @vape/api build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @vape/api test:unit && pnpm --filter @vape/web test:unit && pnpm --filter @vape/worker test",
    "test:integration": "pnpm --filter @vape/api test:integration",
    "test:e2e": "pnpm --filter @vape/web test:e2e",
    "test:e2e:operational": "pnpm --filter @vape/api test:e2e:operational",
    "test:security": "pnpm --filter @vape/api test:security",
    "test:load": "node tests/load/smoke.mjs",
    "test:load:disposable": "node tests/load/run-disposable-load.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "admin:create": "pnpm --filter @vape/api admin:create",
    "catalog:import:wotofo": "pnpm --filter @vape/api catalog:import:wotofo",
    "catalog:media:wotofo": "pnpm --filter @vape/api catalog:media:wotofo",
    "catalog:verify:wotofo": "pnpm --filter @vape/api catalog:verify:wotofo",
    "backup:mysql": "node scripts/backup-mysql.mjs",
    "restore:mysql": "node scripts/restore-mysql.mjs",
    "restore:drill": "node scripts/restore-drill.mjs",
    "smoke:deployment": "node scripts/deployment-smoke.mjs",
    "db:doctor": "node scripts/db-doctor.mjs",
    "verify:db-privileges": "node scripts/verify-runtime-db-privileges.mjs",
    "verify:restore": "node scripts/verify-restored-database.mjs",
    "test:operations": "node --test scripts/tests/*.test.mjs tests/load/*.test.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@prisma/client": "6.19.3",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "prisma": "6.19.3",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "typescript-eslint": "8.66.0"
  }
}
